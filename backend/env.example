PORT=3001

# Environment: development | test | production
ENVIRONMENT=development

# CORS (comma-separated string or JSON array). Vite default origin is http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# Database (Postgres + SQLAlchemy async)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/classmate

# JWT / cookies (placeholder values; change in prod)
JWT_SECRET=dev-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Cookie options
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# CSRF (double-submit cookie)
CSRF_ENABLED=true
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_COOKIE_PATH=/
CSRF_COOKIE_SAMESITE=lax

# LLM provider: gemini (dev) | anthropic (prod)
# To switch prod to Claude: set LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY.
LLM_PROVIDER=gemini

# LLM api keys
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
# OpenAI key is used for RAG embeddings.
OPENAI_API_KEY=

# LLM models + chat behavior
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-sonnet-4-6
CHAT_TEMPERATURE=0.0
CHAT_HISTORY_MAX_MESSAGES=12

# Per-task model selection (app/ai/model_roles.py): tier each pipeline step by
# job. Current mapping:
#   Haiku  (Anthropic): router, clarify, answer-without-context, title
#   Sonnet (Anthropic): retrieval-query-gen, cited-answer, lecture-summary
#   Flash  (Gemini):    chapters, course-summary
# So a fully-configured pipeline uses BOTH Anthropic and Gemini (plus OpenAI for
# embeddings). Defaults are on.
# Set MODEL_ROLES_ENABLED=false to route every step through the single
# LLM_PROVIDER model above. Sonnet reuses ANTHROPIC_MODEL, Flash reuses
# GEMINI_MODEL; only the Haiku tier needs its own model string. A tier whose
# provider key is unset falls back to the LLM_PROVIDER model.
MODEL_ROLES_ENABLED=true
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5

# Telemetry / tracing (dev-friendly defaults)
# LangChain tracing/telemetry (off by default for local dev).
LANGCHAIN_TRACING_V2=false
LANGCHAIN_TELEMETRY=false

# RAG (core)
RAG_ENABLED=true
RAG_TOP_K=4
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200

# RAG embeddings (OpenAI; dimension must match pgvector schema: 1536 dims)
RAG_EMBEDDING_MODEL=text-embedding-3-small

# S3 uploads (presigned)
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=classmate-dev
S3_ACCESS_KEY_ID=access-id
S3_SECRET_ACCESS_KEY=access-key
S3_PRESIGN_EXPIRES_SECONDS=900
S3_DOWNLOAD_EXPIRES_SECONDS=300

# Presign window for extracted audio URLs used by Runpod.
# Must be long enough for the full transcription job + retries.
S3_AUDIO_PRESIGN_EXPIRES_SECONDS=3600

# Max upload size (bytes). Sized for lecture videos (1 GiB). Stays under S3's
# 5 GiB single-PUT limit (no multipart upload). Keep in sync with the frontend
# VITE_UPLOAD_MAX_SIZE_MB hint.
UPLOAD_MAX_SIZE_BYTES=1073741824

# ffmpeg / ffprobe (used for extracting audio + thumbnails from uploaded videos)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Thumbnail capture (seconds into the video to grab a frame). Videos at/above
# THUMBNAIL_LONG_VIDEO_MIN_SECONDS seek further in (the opening frame of a long
# lecture is often black/intro).
THUMBNAIL_SEEK_SECONDS=1.0
THUMBNAIL_LONG_VIDEO_MIN_SECONDS=300.0
THUMBNAIL_LONG_SEEK_SECONDS=60.0

# Runpod serverless (faster-whisper) — powers video transcription.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_POLL_INTERVAL_SECONDS=2.0
# Overall job budget (poll deadline in /run mode, blocking timeout in /runsync mode).
RUNPOD_TIMEOUT_SECONDS=1800
# Per-request HTTP timeout for /run + /status polling calls.
RUNPOD_HTTP_TIMEOUT_SECONDS=120
# Use /runsync for simplest integration (true), or /run + poll (false).
RUNPOD_USE_RUNSYNC=true
# Default model passed to the standard faster-whisper worker.
RUNPOD_WHISPER_MODEL=base

# Semantic chapterization (LLM-generated chapters). Off by default: each
# lecture gets a single "Full Lecture" fallback chapter with no LLM call.
CHAPTERS_ENABLED=false

# "Help ClassMate learn" answer ratings (in progress). The backend endpoints
# and DB columns are not built yet; pairs with the frontend VITE_FEEDBACK_ENABLED.
FEEDBACK_ENABLED=false

# DSPy tracing via MLflow autolog (dev-only; needs the mlflow dev dependency).
DSPY_TRACING_ENABLED=false
