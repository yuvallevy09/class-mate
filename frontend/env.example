VITE_API_URL=http://localhost:3001

VITE_CHAT_ENABLED=true

# Stream chat answers over SSE (set to false for the legacy blocking fallback).
VITE_CHAT_STREAMING=true

# "Help ClassMate learn" answer ratings (in progress — currently a localStorage
# stub; the backend endpoints are not built yet).
VITE_FEEDBACK_ENABLED=false

# Used for UI hints + the client-side pre-check (the backend enforces the real
# limit via UPLOAD_MAX_SIZE_BYTES). Keep this in sync with the backend: 1 GiB
# here matches UPLOAD_MAX_SIZE_BYTES=1073741824.
VITE_UPLOAD_MAX_SIZE_MB=1024



